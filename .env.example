# Application Configuration
PROJECT_NAME="Role-Based Secure Financial Document Vault"
API_V1_STR="/api/v1"

# Cryptographic Keys (Local Test Keys)
# FERNET_SECRET_KEY is a compatibility name and must be a URL-safe Base64 string
# that decodes to exactly 32 bytes for AES-256-GCM.
FERNET_SECRET_KEY=
JWT_SECRET_KEY=
# ALGORITHM supports HS256 only.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Database & Storage Configuration
DATABASE_URL=sqlite:///./vault.db
STORAGE_DIR=./vault_storage