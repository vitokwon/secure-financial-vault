# Application Configuration
PROJECT_NAME="Role-Based Secure Financial Document Vault"
API_V1_STR="/api/v1"

# Cryptographic Keys (Local Test Keys)
# FERNET_SECRET_KEY must be a 32-byte base64-encoded symmetric key.
FERNET_SECRET_KEY=
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database & Storage Configuration
DATABASE_URL=sqlite:///./vault.db
STORAGE_DIR=./vault_storage