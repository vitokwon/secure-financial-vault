# Application Configuration
PROJECT_NAME="Role-Based Secure Financial Document Vault"
API_V1_STR="/api/v1"

# Cryptographic Keys (Local Development)
# ENCRYPTION_KEY must be URL-safe base64 that decodes to exactly 32 raw bytes.
# Legacy compatibility fallback: FERNET_SECRET_KEY is also accepted if ENCRYPTION_KEY is unset.
ENCRYPTION_KEY=
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Database & Storage Configuration
DATABASE_URL=sqlite:///./vault.db
STORAGE_DIR=./vault_storage